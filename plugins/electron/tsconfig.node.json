{
  "compilerOptions": {
    "target": "es2023",
    "module": "commonjs",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleDetection": "force",
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/main", "src/preload"]
}
