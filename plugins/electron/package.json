{
  "name": "plugumi-electron",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.node.json && tsc -p tsconfig.app.json && vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.app.json",
    "start": "pnpm run build && electron ."
  },
  "dependencies": {
    "@plugumi/plugin-shell": "workspace:*",
    "@solidjs/router": "1.0.3",
    "solid-js": "1.9.19",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "^8.18.1",
    "electron": "45.3.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-solid": "2.11.16"
  }
}
