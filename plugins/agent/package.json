{
  "name": "plugumi-agent",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "plugumi-agent": "dist/cli.js"
  },
  "files": [
    "dist/*.js"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "prepack": "pnpm run build",
    "start": "node dist/cli.js",
    "test": "pnpm run build && node --test"
  },
  "dependencies": {
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
